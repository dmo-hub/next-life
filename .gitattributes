# eol=lf: build เขียน LF ล้วน (toLf ใน src/site/build.mjs) — checkout เป็น CRLF แล้ว git จะเห็นว่าแก้ทุกครั้งที่ build
# จน checkout/stash ไม่ยอม · หน้าเขียนมือก็โดน เพราะ build ฉีดตัวเลขเขียนทับ (แค่ EOL ไม่เปลี่ยนวิธี merge)
docs/**/*.html text eol=lf
# ไฟล์แยกของหน้าเล่น + CSS ฟอนต์กลาง (ui-redo 96) — build เขียน LF เหมือนหน้า html
docs/*.js text eol=lf
docs/fonts/*.css text eol=lf

# ไฟล์ที่ build สร้างทั้งไฟล์ (play.html + GEN_PAGES ใน src/site/build.mjs)
# merge=build: ตอน merge เก็บฝั่งตัวเองไว้ ไม่ต่อข้อความ — CONTENT ใน play.html อยู่บรรทัดเดียว สอง branch แก้ content คนละที่ก็ชนทุกครั้ง
#   driver ตั้งในเครื่องครั้งเดียว: npm run setup:git (ไม่ตั้ง = merge ข้อความตามปกติ ชนเหมือนเดิม)
#   หลัง merge ต้อง node build.mjs แล้ว commit docs — ไม่ build จะได้ไฟล์ของฝั่งเดียว (ด่าน "build ตรง commit" จับได้)
# หน้าเขียนมือ index/about/otherworld/gdd ห้ามใส่ merge=build — build แค่ฉีดตัวเลข เนื้อที่เหลือต้อง merge จริง
docs/play.html     merge=build
docs/catalog.html  merge=build
docs/guide.html    merge=build
# หน้าเล่นแยกไฟล์ (ui-redo 96): ข้อมูล · สคริปต์ · service worker · CSS ฟอนต์ build สร้างทั้งไฟล์ (src/site/play-files.mjs · fonts.mjs)
docs/play-data.js  merge=build
docs/play.js       merge=build
docs/sw.js         merge=build
docs/fonts/fonts.css merge=build
